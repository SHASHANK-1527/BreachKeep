FROM breachkeep/base
# network room: network-firewall
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN echo 'wireshark-common wireshark-common/install-setuid boolean false' | debconf-set-selections \
    && apt-get update && apt-get install -y --no-install-recommends util-linux \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /usr/local/lib/bk
COPY --chown=root:root firewall.sh /usr/local/bin/room.sh
COPY --chown=root:root bkguard.sh /usr/local/bin/bkguard
COPY --chown=root:root check      /usr/local/bin/check
RUN chmod 755 /usr/local/bin/room.sh /usr/local/bin/bkguard /usr/local/bin/check
WORKDIR /home/student
# starts as root (launches target services), drops to student for the shell.
CMD ["bash", "/usr/local/bin/room.sh"]
