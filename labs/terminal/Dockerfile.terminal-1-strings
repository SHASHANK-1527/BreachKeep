FROM breachkeep/base
# Room: strings (medium). Needs binutils for `strings`.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends binutils \
    && rm -rf /var/lib/apt/lists/*
COPY --chown=root:root strings.sh /usr/local/bin/room.sh
RUN chmod 755 /usr/local/bin/room.sh
USER student
WORKDIR /home/student
CMD ["bash", "/usr/local/bin/room.sh"]
