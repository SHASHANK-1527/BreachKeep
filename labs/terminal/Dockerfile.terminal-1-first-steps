FROM breachkeep/base
# Room: First Steps (mandatory). Navigation only — `find` is removed on purpose
# so students must walk the tree by hand.
USER root
RUN rm -f /usr/bin/find
COPY --chown=root:root first-steps.sh /usr/local/bin/room.sh
RUN chmod 755 /usr/local/bin/room.sh
USER student
WORKDIR /home/student
CMD ["bash", "/usr/local/bin/room.sh"]
