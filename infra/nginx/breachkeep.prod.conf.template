# PRODUCTION nginx config (HTTPS). ${DOMAIN} and ${ADMIN_SECRET_PATH} are filled
# in from .env when the container starts. Local dev keeps using breachkeep.conf.

# Websocket upgrades (the labs terminal) need Connection: upgrade; ordinary API
# requests must NOT get it. proxy_common.conf reads this.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

map $cookie_bk_gate $has_gate { default 0; "~.+" 1; }

# Per-IP request limits. A whole class shares ONE campus IP, so these are
# generous: they stop floods from a single machine, not a class of 100+.
limit_req_zone $binary_remote_addr zone=bk_api:10m  rate=100r/s;
limit_req_zone $binary_remote_addr zone=bk_auth:10m rate=20r/s;
limit_req_status 429;

server_tokens off;

# Anything that is not our domain (bots scanning the raw IP) gets dropped.
server {
  listen 80 default_server;
  listen 443 ssl default_server;
  ssl_reject_handshake on;
  return 444;
}

# Plain HTTP -> HTTPS
server {
  listen 80;
  server_name ${DOMAIN};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  client_max_body_size 2m;
  client_body_timeout 15s;
  client_header_timeout 15s;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # ---------- API ----------
  location = /api/auth/verify-access-code { limit_req zone=bk_auth burst=200 nodelay; proxy_pass http://api:5000; include /etc/nginx/proxy_common.conf; }
  location = /api/access/resend-daily     { limit_req zone=bk_auth burst=50  nodelay; proxy_pass http://api:5000; include /etc/nginx/proxy_common.conf; }
  location = /api/health                  { proxy_pass http://api:5000; include /etc/nginx/proxy_common.conf; }
  location = /api/status                  { proxy_pass http://api:5000; include /etc/nginx/proxy_common.conf; }
  location /api/      { limit_req zone=bk_api  burst=500 nodelay; proxy_pass http://api:5000; include /etc/nginx/proxy_common.conf; }

  # ---------- labs (not used yet; provisioner is internal-only) ----------
  location /labs/ {
    proxy_pass http://provisioner:6000;
    include /etc/nginx/proxy_common.conf;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # ---------- web-app target (the Trading Post) for the web dungeon ----------
  location /app/ {
    proxy_pass http://provisioner:6000;
    include /etc/nginx/proxy_common.conf;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # ---------- static bundles ----------
  root /usr/share/nginx/html/landing;

  # The Warden panel lives in the APP bundle but is opened without a gate
  # cookie, so it needs its own route (otherwise it shows the landing page).
  location = ${ADMIN_SECRET_PATH} {
    root /usr/share/nginx/html/app;
    try_files /index.html =404;
  }

  # Hashed JS/CSS + images: landing's own files first, then the app's.
  location /assets/ {
    try_files $uri @app_assets;
    expires 1h;
  }
  location @app_assets {
    root /usr/share/nginx/html/app;
    expires 1h;
  }

  location / {
    if ($has_gate) { rewrite ^ /app$uri last; }
    try_files $uri /landing.html;
  }

  location /app {
    alias /usr/share/nginx/html/app;
    try_files $uri /app/index.html;
  }
}
