# ===== BreachKeep PRODUCTION .env =====
# Copy to ".env" on the server and fill every CHANGE-ME. Never commit the real .env.

# --- site ---
DOMAIN=CHANGE-ME.duckdns.org
# Used for links inside emails (password reset). Defaults to https://$DOMAIN.
PUBLIC_BASE_URL=https://CHANGE-ME.duckdns.org
# MUST be exactly "production". Anything else leaves the access gate open, makes
# session cookies non-secure, and keeps the dev shortcuts alive.
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongo:27017/breachkeep

# three DIFFERENT random strings:  openssl rand -hex 32
JWT_SECRET=CHANGE-ME
FLAG_HMAC_SECRET=CHANGE-ME
PROVISIONER_SHARED_SECRET=CHANGE-ME

# --- email (Gmail app password, 16 letters, no spaces) ---
EMAIL_USER=CHANGE-ME@gmail.com
EMAIL_PASS=CHANGE-ME

# --- Google sign-in (same value twice) ---
GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com

# --- access codes: NEW values, not the ones from the repo ---
COMMON_ACCESS_CODE=CHANGE-ME
ADMIN_LANDING_CODE=CHANGE-ME
ADMIN_SECRET_PATH=/CHANGE-ME
VITE_ADMIN_PATH=/CHANGE-ME
# keep the SINGLE QUOTES around the hash (it contains $ signs)
# IMPORTANT: in this .env the hash is used LITERALLY (env_file), so keep the
# single "$" characters exactly as hashAdmin.js printed them. Do NOT double
# them to "$$" — that only applies to inline docker-compose environment: values.
ADMIN_PASSWORD_HASH='CHANGE-ME'

# --- cookies: leave EMPTY in production ---
COOKIE_DOMAIN=

# --- class sizing ---
TRUST_PROXY_HOPS=1
AUTH_RATE_MAX=1500
STRICT_RATE_MAX=20
BCRYPT_COST=10

# --- provisioner (labs; unused until dungeons go live) ---
PROVISIONER_URL=http://provisioner:6000
PROV_PORT=6000
DOCKER_SOCKET=/var/run/docker.sock
MAX_LIVE_DUNGEONS=2
CONTAINER_CPU=0.5
CONTAINER_MEM=128m
IDLE_TIMEOUT_MIN=30

# --- frontend ---
VITE_API_BASE=/api

# --- test mode: BOTH must be false on the live site ---
# TEST_MODE=true opened /api/dev/* and a mock Google identity that signed every
# visitor in as the same account. Leave these false in production.
TEST_MODE=false
VITE_TEST_MODE=false
