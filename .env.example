# ================= api service =================
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://mongo:27017/breachkeep
JWT_SECRET=change-me-long-random-string
FLAG_HMAC_SECRET=change-me-another-long-random-string

# email (Gmail app password)
EMAIL_USER=
EMAIL_PASS=

# Google Sign-In (OAuth 2.0 Web client id)
GOOGLE_CLIENT_ID=

# access codes
COMMON_ACCESS_CODE=BREACH-2026
ADMIN_LANDING_CODE=WARDEN-9X4Q7
ADMIN_SECRET_PATH=/keep-warden-7f3a9c
ADMIN_PASSWORD_HASH=            # bcrypt hash of your admin password (see scripts/hashAdmin.js)

# provisioner link
PROVISIONER_URL=http://provisioner:6000
PROVISIONER_SHARED_SECRET=change-me-shared-secret

COOKIE_DOMAIN=localhost

# Class-day sizing. The rate limiter is per-IP and a whole class usually shares
# one campus IP, so AUTH_RATE_MAX must be well above your cohort size.
# 1 = nginx only. 2 = Vercel rewrite -> Render.
TRUST_PROXY_HOPS=1
AUTH_RATE_MAX=400
STRICT_RATE_MAX=20
# bcryptjs blocks the event loop; 10 is ~110ms per signup, 12 is ~350ms.
BCRYPT_COST=10

# ================= provisioner service =================
PROV_PORT=6000
DOCKER_SOCKET=/var/run/docker.sock
MAX_LIVE_DUNGEONS=2
CONTAINER_CPU=0.5
CONTAINER_MEM=256m
IDLE_TIMEOUT_MIN=30

# ================= web (Vite) =================
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE=/api
# MUST match ADMIN_SECRET_PATH above — it is baked into the bundle at build time.
VITE_ADMIN_PATH=/keep-warden-7f3a9c

# ================= test mode (local only) =================
# Unlocks /api/dev/* and the in-app test panel: jump to "all nine intro scenes
# finished", re-run the sorting draw, force a house, flip dungeons live without
# a provisioner. Forced OFF whenever NODE_ENV=production.
TEST_MODE=false
VITE_TEST_MODE=false
