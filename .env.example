# ================= test / dev mode =================
TEST_MODE=true
VITE_TEST_MODE=true

# ================= api service =================
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://mongo:27017/breachkeep
JWT_SECRET=change-me-long-random-string
FLAG_HMAC_SECRET=change-me-another-long-random-string

# email (Gmail app password)
EMAIL_USER=
EMAIL_PASS=

# Google Sign-In (OAuth 2.0 Web client id)
GOOGLE_CLIENT_ID=

# access codes
COMMON_ACCESS_CODE=BREACH-2026
ADMIN_LANDING_CODE=WARDEN-9X4Q7
ADMIN_SECRET_PATH=/keep-warden-7f3a9c
ADMIN_PASSWORD_HASH=            # bcrypt hash of your admin password (see scripts/hashAdmin.js)

# provisioner link
PROVISIONER_URL=http://provisioner:6000
PROVISIONER_SHARED_SECRET=change-me-shared-secret

COOKIE_DOMAIN=localhost

# ================= provisioner service =================
PROV_PORT=6000
DOCKER_SOCKET=/var/run/docker.sock
MAX_LIVE_DUNGEONS=2
CONTAINER_CPU=0.5
CONTAINER_MEM=256m
IDLE_TIMEOUT_MIN=30

# ================= web (Vite) =================
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE=/api
